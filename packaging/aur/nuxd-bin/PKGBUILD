# Maintainer: sidmax7 <sidmax81 at gmail dot com>
#
# Installs the prebuilt release: the desktop app from the release's .deb
# and the `nuxd` command from the release's CLI archive. The app updates
# itself only when run as an AppImage, so pacman stays in charge here.
# Release steps: docs/releasing.md ("AUR").

pkgname=nuxd-bin
_name=nux-downloader
pkgver=0.1.0
pkgrel=1
pkgdesc="Download manager that uses every network connection at once (desktop app and nuxd CLI)"
arch=('x86_64')
url="https://github.com/sidmax7/nux-downloader"
license=('Apache-2.0')
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libayatana-appindicator'  # loaded at run time for the tray icon
  'libsoup3'
  'webkit2gtk-4.1'
)
provides=('nuxd' "${_name}")
conflicts=('nuxd' "${_name}")
options=('!debug')
source=(
  "${_name}_${pkgver}_amd64.deb::${url}/releases/download/v${pkgver}/${_name}_${pkgver}_amd64.deb"
  "nuxd-${pkgver}-${CARCH}-unknown-linux-gnu.tar.gz::${url}/releases/download/v${pkgver}/nuxd-${pkgver}-${CARCH}-unknown-linux-gnu.tar.gz"
)
# Fill in with `updpkgsums` after the release is published; they must
# match the release's SHA256SUMS.
sha256sums=('SKIP'
            'SKIP')
noextract=("${_name}_${pkgver}_amd64.deb")

package() {
  local deb="${srcdir}/${_name}_${pkgver}_amd64.deb"
  local tmp="${srcdir}/deb"
  mkdir -p "${tmp}"
  bsdtar -xf "${deb}" -C "${tmp}"
  bsdtar -xf "${tmp}"/data.tar.* -C "${pkgdir}"

  # Tauri names the launcher after the product; give it a plain name.
  mv "${pkgdir}/usr/share/applications/Nux Downloader.desktop" \
     "${pkgdir}/usr/share/applications/${_name}.desktop"

  local cli="${srcdir}/nuxd-${pkgver}-${CARCH}-unknown-linux-gnu"
  install -Dm755 "${cli}/nuxd" "${pkgdir}/usr/bin/nuxd"
  install -Dm644 "${cli}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${cli}/THIRD_PARTY_NOTICES.md" \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
}
